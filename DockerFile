FROM node:18-alpine

# Instalar git para poder clonar los submódulos
RUN apk add --no-cache git

WORKDIR /app

# Clonar el repositorio principal junto con sus submódulos de forma explícita
# (Reemplaza la URL con la de tu repositorio de backend si es necesario, o usa el clonado recursivo)
RUN git clone --recurse-submodules https://github.com/mangelbarrera22/Glaze-backend.git .

# Copiar dependencias e instalarlas
COPY package*.json ./
RUN npm install

EXPOSE 3000
CMD ["node", "server.js"]