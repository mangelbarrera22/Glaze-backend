FROM node:18-alpine

# Instalar git para poder clonar los submódulos
RUN apk add --no-cache git

WORKDIR /app

# Copiar todo el código (incluyendo la configuración de git)
COPY . .

# Inicializar y actualizar los submódulos explícitamente en el build
RUN git submodule update --init --recursive || true

# Instalar las dependencias del backend
RUN npm install

EXPOSE 3000
CMD ["node", "server.js"]